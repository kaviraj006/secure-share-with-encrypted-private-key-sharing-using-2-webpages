# SecureShare // KEY EXCHANGE Environment Configuration
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-32-bytes
FLASK_ENV=development
PORT=5001
DATABASE_URL=sqlite:///instance/secureshare_keyx.db
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
RATE_LIMIT_PER_MINUTE=60
